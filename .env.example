# Copy to .env and fill in. .env is gitignored — never commit real keys.
# LiteLLM master key (local demo; use a scoped virtual key for shared deploys).
LITELLM_MASTER=sk-change-me-to-something-random
# App-level key embedded in the built UI. Generate once; not a provider secret.
APP_API_KEY=any-uuid-or-hex-you-generate-once
# OpenCode Go credentials. The key is IP-allowlisted, so allowlist your public IP.
OPENCODE_API_KEY=
OPENCODE_SESSION_ID=any-uuid-you-generate-once
# Keep this stable: the Postgres PVC keeps the password it was initialised with.
PG_PASSWORD=generate-a-stable-password
# 1 = canned LLM responses (no provider key needed); 0 = live answers.
MOCK_LLM=1
